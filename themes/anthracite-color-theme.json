    "extensionButton.prominentForeground": "#181a1f",
    "extensionButton.prominentHoverBackground": "#c8ccd4"
  },
  "tokenColors": [
    {
      "settings": { "foreground": "#c8ccd4" }
    },
    {
      "scope": ["comment", "punctuation.definition.comment"],
      "settings": { "foreground": "#515766", "fontStyle": "italic" }
    },
    {
      "scope": ["string", "string.quoted", "string.template"],
      "settings": { "foreground": "#7E9E2D" }
    },
    {
      "scope": ["constant.numeric", "constant.language", "constant.character"],
      "settings": { "foreground": "#935cd1" }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.function",
        "keyword.operator.new"
      ],
      "settings": { "foreground": "#CC71BC" }
    },
    {
      "scope": ["storage.type", "storage.modifier"],
      "settings": { "foreground": "#de456b" }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call"
      ],
      "settings": { "foreground": "#3398DB" }
    },
    {
      "scope": ["variable", "variable.other", "variable.parameter"],
      "settings": { "foreground": "#acb1bd" }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": { "foreground": "#24B5A8" }
    },
    {
      "scope": ["entity.name.tag"],
      "settings": { "foreground": "#24B5A8" }
    },
    {
      "scope": ["entity.other.attribute-name"],
      "settings": { "foreground": "#c9a022" }
    },
    {
      "scope": ["keyword.operator"],
      "settings": { "foreground": "#c8ccd4" }
    },
    {
      "scope": [
        "punctuation",
        "meta.brace",
        "punctuation.separator",
        "punctuation.terminator"
      ],
      "settings": { "foreground": "#515766" }
    },
    {
      "scope": ["string.regexp"],
      "settings": { "foreground": "#D26D32" }
    },
    {
      "scope": ["invalid", "invalid.illegal"],
      "settings": { "foreground": "#C13838" }
    },
    {
      "scope": ["markup.heading"],
      "settings": { "foreground": "#3398DB", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.bold"],
      "settings": { "foreground": "#c8ccd4", "fontStyle": "bold" }
    },
    {
      "scope": ["markup.italic"],
      "settings": { "foreground": "#c8ccd4", "fontStyle": "italic" }
    },
    {
      "scope": ["markup.underline.link"],
      "settings": { "foreground": "#3398DB", "fontStyle": "underline" }
    }
  ],
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "comment": "#515766",
    "string": "#7E9E2D",
    "keyword": "#CC71BC",
    "number": "#935cd1",
    "function": "#3398DB",
    "method": "#3398DB",
    "variable": "#acb1bd",
    "parameter": "#acb1bd",
    "property": "#acb1bd",
    "class": "#24B5A8",
    "interface": "#24B5A8",
    "enum": "#24B5A8",
    "type": "#24B5A8",
    "namespace": "#c9a022",
    "decorator": "#D26D32",
    "macro": "#D26D32"
  }
}
